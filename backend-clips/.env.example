PORT=4567
BACKEND_SECRET=ton-secret-pour-authentifier-les-requetes

# Optionnel : chemin vers ffmpeg avec libass (sous-titres)
# brew install ffmpeg-full
# FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg

# Groq Cloud — Whisper STT + chat (moments / hooks). Pas OpenAI.
# https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# gpt-oss-20b échoue souvent en JSON mode sur detectMoments (json_validate_failed vide).
# GROQ_CHAT_FALLBACKS=qwen/qwen3.6-27b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Langue « contexte » (hooks) si probe/meta KO. Ne force PAS Whisper STT.
# WHISPER_LANGUAGE=fr
# Forcer language= sur Whisper (monolingue only) — casse l’audio bilingue EN↔FR.
# WHISPER_FORCE_LANGUAGE=0
# Ne pas mettre d’instructions dans WHISPER_PROMPT (Whisper les répète dans le texte).
# WHISPER_PROMPT=

SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Cloudflare R2 (obligatoire — stockage exclusif des clips MP4) ───────
# Sans ces variables, les uploads de clips échouent (plus de fallback Supabase Storage).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL publique du bucket (sans slash final), ex: https://pub-xxxx.r2.dev
R2_PUBLIC_URL=

# ── Rendu clips (render_subtitles.py) — perf Railway / CPU ─────────────
# Le goulot est souvent : décode 1080p + Pillow + pipe raw + x264 (voir logs ffmpeg speed~0.2x).
#
# Valeurs recommandées Railway Pro Plan (~8 vCPU / 8 GB RAM / replica) — prod actuelle :

# FPS de sortie max. "full" / source / off / 0 = même FPS que la source.
# 24 divise ~par 1.25 le nombre de frames traitées vs 30 fps. Recommandé prod.
RENDER_MAX_OUTPUT_FPS=24

# Preset x264 : ultrafast > superfast > veryfast > … — plus rapide = encode plus vite, qualité un peu moindre.
RENDER_LIBX264_PRESET=veryfast

# Threads x264 : 4 avec RENDER_CONCURRENCY=2 (2 encodes × 4 threads / 8 vCPU). 6 si concurrence 1.
RENDER_LIBX264_THREADS=4

# CRF x264 : plus élevé = encode un peu plus vite / fichier plus petit, image un peu moins nette.
# 26 = Pro (un peu plus net) ; 28 = Hobby (priorité vitesse).
RENDER_LIBX264_CRF=26

# Bitrate AAC export (même valeur free/paid — pas de tier qualité).
# 192k + ar=48000 ac=2 (déjà dans le code) : suffisant TikTok/Reels.
# RENDER_AUDIO_BITRATE=192k

# Cache Whisper R2 (transcriptions/v1/…). Même JSON = même qualité.
# WHISPER_CACHE=0 pour désactiver.
# WHISPER_CACHE=1

# ── Smart-crop (détection visage pass 1) ───────────────────────────────
# Intervalle de détection (en frames). Défaut 15. Augmenter = moins d'appels Haar, suivi moins fin.
# SMART_CROP_DETECT_INTERVAL=15

# Largeur max pour le downscale avant détection visage. Défaut = résolution source (pas de downscale).
# Recommandé prod : 480 (gros gain CPU, coordonnées normalisées préservées)
SMART_CROP_MAX_WIDTH=480

# ── Multi-clips (budget local vs production) ───────────────────────────
# Profil : local = peu de clips (coût dev) ; production = paliers selon la durée (3–10 clips).
# Détection auto : si RAILWAY_ENVIRONMENT est défini (Railway) → production. Sinon → local.
# Surcharge explicite (prioritaire) :
# VYLL_CLIP_PROFILE=local
# VYLL_CLIP_PROFILE=production
#
# File d'attente : en local, POST /jobs self-claim (status=processing) pour que
# Railway ne vole pas le job sur la DB Supabase partagée. Tag payload.queue_scope=local.

# Overrides plafond clips (1–10). Free hard-cap 3 · Creator/Studio hard-cap 10.
# Respecté aussi en production.
# CLIPS_MAX_PER_JOB=10
# MOMENTS_MAX=13

# En production : échelle <2→1, 2–5→2, 5–7→3, 7–15→4, 15–30→6, ≥30→10
# puis min avec hard-cap plan (free=3, paid=10).
# Railway : CLIPS_MAX_PER_JOB=10 recommandé (le plan borne ensuite).

# Rendus Python en parallèle (plusieurs clips à la fois).
# 1 = Hobby / machine serrée.
# 2 = Pro recommandé (avec RENDER_LIBX264_THREADS=4) — 2 clips × (main+clean).
# Défaut dans le code si absent : 1
RENDER_CONCURRENCY=2

# Jobs complets (download+whisper+render) en parallèle PAR instance.
# 1 = un job à la fois sur cette replica (recommandé — évite BrokenPipe ffmpeg).
# Multi-users : file partagée Supabase (claim_next_clip_backend_job) + N replicas Railway.
# Ne pas créer un second service backend. Ne pas monter MAX_CONCURRENT_JOBS>1.
# Pro : scale les replicas (ex. 12) plutôt que d'augmenter ce plafond.
# Défaut code : 1
MAX_CONCURRENT_JOBS=1

# Poll worker file partagée (ms). Défaut 2000. Pro : 1000 pour claim plus réactif.
JOB_WORKER_POLL_MS=1000

# Fail jobs processing sans heartbeat (ms). Défaut 40 min.
# Doit rester aligné avec le reclaim SQL (migration 029 : updated_at < 40 min).
# JOB_STALE_MS=2400000

# ── YouTube (yt-dlp) : chaîne de clients + cookies Netscape ───────────────────────
# OAuth2 YouTube n'est plus supporté par yt-dlp (2024+)
# Challenges JS YouTube (EJS) : Deno installé dans le Dockerfile ; défaut --js-runtimes deno
# + --remote-components ejs:github. Override : YT_DLP_JS_RUNTIME=node|deno
# YT_DLP_REMOTE_COMPONENTS=ejs:github   # ou ejs:npm ; false pour désactiver
# Auth YouTube : cookies Netscape uniquement (YT_DLP_COOKIES_BASE64)
# Sans cookies : pareil, souvent usable ; IP datacenter peut être bloquée.
#
# web et mweb : à éviter — YouTube exige désormais un PO Token GVS pour ces clients
# (playability status UNPLAYABLE sans token). « default » est le client fiable qui expose
# encore du 1080p en AVC — format typique avc1 id 137 (voir yt-dlp -F).
# Chaîne (ordre = priorité → fallback). yt-dlp réessaie avec le client suivant si échec.
# `tv` est souvent DRM (expérience YouTube) — ne pas le mettre en tête.
# Cookies Netscape périmés : retry sans cookies, puis android_sdkless / web_embedded (1080p).
# android seul ~360p ; ios souvent storyboard — pas en tête de chaîne.
# Rejet URL si hauteur source sous le palier 1080p par défaut (upload exclu) — erreur LOW_SOURCE_QUALITY.
# Exception : seuil effectif 1000 px quand cette valeur = 1080 (YouTube encode souvent ~1012 px de haut).
# Défaut code = 1080 si variable absente. Ne pas baisser si tu veux du clips « quali » uniquement.
# Déblocage d’urgence seulement : 720, ou 0 = désactive le test (déconseillé, qualité pourrie).
# YT_DLP_MIN_SOURCE_HEIGHT=1080
# Ex. si tu réintroduis web/mweb : prévoir PO Token GVS côté yt-dlp — sinon préférer default seul.
YT_DLP_YOUTUBE_CLIENT_CHAIN=default,web_embedded,android_sdkless
# IPv4 forcé (utile en local : HLS YouTube via IPv6 → « Did not get any data blocks »)
# YT_DLP_FORCE_IPV4=1
# web/mweb sont ignorés (pas de ≥720 sans PO Token) sauf :
# YT_DLP_ALLOW_WEB_CLIENTS=1
# Skip la watch page YouTube (évite le 429 webpage). 0 pour désactiver.
# YT_DLP_PLAYER_SKIP=webpage
# Pause 1s entre requêtes extraction + backoff HTTP sur 429.
# YT_DLP_SLEEP_REQUESTS=1
# YT_DLP_RETRY_SLEEP=http:exp=2:20:2

# Cache yt-dlp — le backend passe toujours --cache-dir ici (défaut : tmp/vyrll-clips/yt-dlp-cache).
# YT_DLP_CACHE_DIR=/tmp/yt-dlp-cache

# Cookies Netscape (prod Railway)
# YT_DLP_USE_COOKIES=false   # désactive totalement l'usage de --cookies / --cookies-from-browser

# Railway : max ~32k caractères par variable. Si la base64 dépasse, couper en morceaux :
#   YT_DLP_COOKIES_BASE64_1=<premiers ~32000 caractères>
#   YT_DLP_COOKIES_BASE64_2=<suite sans espace entre les deux>
# (ne pas définir YT_DLP_COOKIES_BASE64 en même temps que _1 si tu utilises le découpage)
# YT_DLP_COOKIES_BASE64=...

# Déprécié : un seul client ou liste ; préférer YT_DLP_YOUTUBE_CLIENT_CHAIN
# YT_DLP_NO_COOKIE_PLAYER_CLIENT=android

# YOUTUBE_API_KEY=...   # optionnel : durée via API Data v3 avant yt-dlp

# Rétention free : purge auto des clip_jobs + R2 après N jours (défaut 2).
# FREE_CLIP_RETENTION_DAYS=2
# Intervalle du reaper (ms, défaut 1h).
# EXPIRED_FREE_CLIPS_REAP_MS=3600000

# ── Auto long (> 1h15) : audio puis extraits. Filet replica 8 Go / fusible 7 Go.
LONG_AUTO_ENABLED=1
# LONG_AUTO_FORCE=1 force le chemin long sous 1h15 (palier test 20 min).
# Fusible logiciel (cgroup memory.current). Replica 8 Go → 7000 (1 Go de marge).
# 2 fenêtres long-auto seulement si cette valeur >= 10000 (12–16 Go).
JOB_RAM_SOFT_MB=7000
# 1 = une fenêtre à la fois (défaut / 8 Go). 2 = parallèle, ignoré tant que JOB_RAM_SOFT_MB < 10000.
# LONG_AUTO_WINDOW_CONCURRENCY=1
# JOB_WALL_LONG_MS=5400000
# JOB_WINDOW_WALL_MS=900000
# Replica Railway cible : 8 Go RAM / 8 vCPU, 1 replica.
