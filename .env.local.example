# Copy to .env.local and fill in values (never commit .env.local).
# Supabase: Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Newer projects may use publishable key instead of anon:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Server-only (profiles bootstrap, admin); keep secret
SUPABASE_SERVICE_ROLE_KEY=

# Lemon Squeezy — checkout URLs (legacy; Stripe is preferred)
# NEXT_PUBLIC_LS_CREATOR_URL=https://vyrll.lemonsqueezy.com/buy/xxx-creator
# NEXT_PUBLIC_LS_STUDIO_URL=https://vyrll.lemonsqueezy.com/buy/xxx-studio

# Lemon Squeezy webhook (Settings → Webhooks → URL: https://<domain>/api/webhooks/lemonsqueezy)
# LEMONSQUEEZY_WEBHOOK_SECRET=
# Variant IDs from product variants (Dashboard → Products → variant id)
# LEMONSQUEEZY_VARIANT_CREATOR_ID=
# LEMONSQUEEZY_VARIANT_STUDIO_ID=

# Stripe — Dashboard → Developers → API keys (prefer restricted rk_ for secret)
# Publishable key is safe for the browser; secret + webhook secret are server-only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
# Webhook endpoint: https://<domain>/api/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs (Products → Creator/Studio → monthly price)
STRIPE_PRICE_CREATOR=price_...
STRIPE_PRICE_STUDIO=price_...

# Promo codes (required to enable /api/redeem-code). No hardcoded fallback.
# Format: CODE:plan:analyses_limit[:credits_limit] or CODE:reanalyze
# PROMO_CODES=MYCODE:creator:20:90

# Optional — see README.md / supabase/README.md
# YOUTUBE_API_KEY=
# OPENAI_API_KEY=
# BACKEND_URL=
# BACKEND_SECRET=
# Public site origin (Railway/prod). Must match the live domain users visit.
# Also set the same URL as Site URL in Supabase Auth → URL Configuration.
# Confirm signup email links use {{ .SiteURL }}/auth/confirm?token_hash=...
# NEXT_PUBLIC_SITE_URL=https://upcut.app
